@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

html,
body {
	@apply h-full overflow-hidden antialiased; /* AppShell scrolls #page itself */
}

/* ── TJNPVScale: monochrome shadcn look on top of Skeleton ── */

/* primary-ish filled = shadcn "default" button: inverted fg/bg */
.variant-filled-primary, .variant-filled-secondary, .variant-filled-tertiary, .variant-filled-success, .variant-filled {
	@apply bg-zinc-900 text-zinc-50 dark:bg-zinc-50 dark:text-zinc-900 !important;
}
/* soft / ghost = shadcn "secondary" / "outline" */
.variant-soft-primary, .variant-soft-secondary, .variant-soft-tertiary, .variant-soft-success, .variant-soft,
.variant-ghost-primary, .variant-ghost-secondary, .variant-ghost-tertiary, .variant-ghost-surface {
	@apply bg-zinc-100 text-zinc-900 ring-1 ring-inset ring-zinc-200 dark:bg-zinc-900 dark:text-zinc-50 dark:ring-zinc-800 !important;
}
.variant-filled-error { @apply bg-red-600 text-white dark:bg-red-700 !important; }
.variant-filled-warning { @apply bg-amber-100 text-amber-900 ring-1 ring-amber-300 dark:bg-amber-950 dark:text-amber-200 dark:ring-amber-800 !important; }

/* surfaces: flat, bordered, no gradients/shadows */
body { @apply bg-white text-zinc-950 dark:bg-zinc-950 dark:text-zinc-50; }
.card { @apply bg-white border border-zinc-200 shadow-none dark:bg-zinc-950 dark:border-zinc-800 !important; }
.card-hover:hover { @apply border-zinc-400 dark:border-zinc-600 scale-100 shadow-none !important; }
.app-bar { @apply bg-white/80 backdrop-blur border-b border-zinc-200 dark:bg-zinc-950/80 dark:border-zinc-800 !important; }
.drawer { @apply bg-white dark:bg-zinc-950 !important; }
.input, .select, .textarea, input[type='text'], input[type='number'], input[type='password'], select, textarea {
	@apply bg-transparent border-zinc-200 dark:border-zinc-800 focus:ring-zinc-400 focus:border-zinc-400 !important;
}
.chip { @apply rounded-md text-xs font-medium; }
.btn, .btn-sm, .btn-icon { @apply font-medium transition-colors hover:brightness-100 hover:opacity-90; }

